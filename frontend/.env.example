# Required: Backend API base URL (include /api)
# Must match where your backend runs. Use 127.0.0.1 if localhost fails.
VITE_API_URL=http://localhost:3000/api

# Cognito (deploy-frontend.sh sets these from Terraform outputs in deployed envs)
# VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXX
# VITE_COGNITO_CLIENT_ID=
# VITE_COGNITO_DOMAIN=https://chm-platform-dev.auth.us-east-1.amazoncognito.com
# VITE_COGNITO_REGION=us-east-1

# App origin for OAuth redirects (dev: devapp.communityhealth.media, platform: testapp.communityhealth.media)
# VITE_APP_URL=https://devapp.communityhealth.media

# Google OAuth via Cognito (off until Google IdP is configured in Cognito)
# VITE_GOOGLE_OAUTH_ENABLED=true

# reCAPTCHA v3 (login/join email+password; deploy-frontend.sh sets from platform.tfvars)
# VITE_RECAPTCHA_SITE_KEY=

# Bypass auth (dev only):
# Option A: Skip route guards - set to true to open /app and /admin without logging in.
# Login / Admin Sign In still work: submit the form once to set a mock session and redirect (no API call).
VITE_DISABLE_AUTH=false

# Option B: Use backend DB fallback login when Cognito is not configured.
# Run: cd backend && npx prisma db seed
# Then login with: dev@chtplatform.local / any-password-8chars
VITE_USE_DEV_AUTH=true
VITE_DEV_USER_ID=

# Editorial WordPress catalog (devapp: ContentHub clips with wordpress field)
# VITE_CATALOG_WORDPRESS_ONLY=true
