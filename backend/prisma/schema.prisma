generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// Run with: npx prisma db seed

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MODEL
// ============================================================================
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  firstName       String
  lastName        String
  authId          String   @unique // Auth0 user ID
  
  // Professional details
  npiNumber       String?  @unique
  specialty       String?
  state           String?
  licenseNumber   String?
  
  // Institution & Location
  institution     String?
  city            String?
  zipCode         String?

  /// E.164 mobile for SMS MFA (Cognito phone_number is source of truth at challenge time).
  phoneNumber     String?

  // Role and status
  role            UserRole @default(HCP)
  status          UserStatus @default(ACTIVE)
  
  // Payment status
  paymentEnabled   Boolean @default(false)
  w9Submitted     Boolean @default(false)
  w9SubmittedAt   DateTime?

  // Stripe Connect Express
  stripeAccountId              String?
  stripeAccountStatus          String?  // onboarding_incomplete, pending, active, restricted, rejected
  stripePayoutsEnabled         Boolean  @default(false)
  stripeOnboardingCompleteAt   DateTime?

  /// Learner preference for how honoraria should be paid (ACH vs paper check).
  preferredPaymentMethod PreferredPaymentMethod?
  /// Last 4 of bank account when ACH is configured (never store full account).
  bankAccountLast4       String?

  /// Terms of Service & Privacy Policy acceptance; re-prompted when termsVersion != CURRENT_TERMS_VERSION.
  termsAcceptedAt DateTime?
  termsVersion    String?

  /// Beta Participant Terms Agreement (beta period only); version e.g. 2026-10-22.
  betaTermsAcceptedAt DateTime?
  betaTermsVersion    String?

  // Earnings tracking
  totalEarnings       Int @default(0)  // Total lifetime earnings in cents
  activitiesCompleted Int @default(0)  // Count of completed programs
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastLoginAt     DateTime?
  
  // Relations
  enrollments     ProgramEnrollment[]
  programRegistrations ProgramRegistration[]
  videoViews      VideoView[]
  surveyResponses SurveyResponse[]
  formJotformProgress FormJotformProgress[]
  payments        Payment[]
  cmeCredits      CMECredit[]
  analyticsEvents AnalyticsEvent[]
  companionConversations CompanionConversation[]
  betaTermsAcceptances BetaTermsAcceptance[]

  @@index([email])
  @@index([authId])
  @@index([stripeAccountId])
  @@index([totalEarnings])
  @@index([betaTermsAcceptedAt])
  @@map("User")
}

/// Immutable audit row for each Beta Participant Terms acceptance (legal export).
model BetaTermsAcceptance {
  id           String   @id @default(cuid())
  userId       String
  termsVersion String
  acceptedAt   DateTime @default(now())
  ipAddress    String?
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([acceptedAt])
  @@index([termsVersion])
  @@map("BetaTermsAcceptance")
}

// ============================================================================
// SESSION MODEL
// ============================================================================
model Session {
  id          String   @id @default(cuid())
  token       String   @unique
  authId      String
  userId      String
  email       String
  name        String
  role        UserRole
  /// Idle expiry — slid forward on authenticated activity via getSession.
  expiresAt   DateTime
  /// Absolute lifetime anchor — session cannot outlive createdAt + SESSION_ABSOLUTE_TTL_SECONDS.
  createdAt   DateTime @default(now())
  accessToken String? // Cognito/legacy access token for MFA/password/chatbot

  @@index([userId])
  @@index([expiresAt])
  @@map("Session")
}

enum UserRole {
  HCP          // Healthcare Professional
  KOL          // Key Opinion Leader
  ADMIN        // Platform Administrator
  SUPER_ADMIN  // Full platform authority (promotes admins, deletes admins)
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ============================================================================
// PROGRAM MODEL
// ============================================================================
model Program {
  id                String   @id @default(cuid())
  title             String
  description       String   @db.Text
  thumbnailUrl      String?
  
  // CME Information
  creditAmount      Float    // CME credits (e.g., 2.5)
  accreditationBody String?  // e.g., "ACCME", "AMA"
  
  // Status and visibility
  status            ProgramStatus @default(DRAFT)
  
  // Sponsorship
  sponsorName       String
  sponsorLogo       String?
  /// Optional banner image URL for the live session detail / registration (admin-provided CDN or public URL).
  sessionHeroImageUrl String?
  /// Session-specific disclaimer shown to learners on registration and detail pages (HTML stripped client-side).
  sessionDisclaimer   String? @db.Text
  
  // Scheduling
  startDate         DateTime?
  endDate           DateTime?
  duration          Int?     // Duration in minutes (for webinars)
  
  // Survey integration (Jotform)
  jotformSurveyId   String?
  jotformSurveyUrl  String?
  requiresSurvey    Boolean @default(false)
  /// Intake / registration form (workflow trigger); embed on branded register page
  jotformIntakeFormUrl String?
  /// Pre-event questionnaire URL (iframe on program register flow)
  jotformPreEventUrl   String?
  /// Host display name ("Get time with …" / "Host: …")
  hostDisplayName      String?
  /// Short host bio shown on the detail page
  hostBio              String?
  /// Speaker / KOL names for the session (distinct from host); stored for display and Zoom panelist registration
  speakers             String[]
  /// Panelist join URLs returned by Zoom when the webinar was created (JSON array of {name,email,joinUrl})
  zoomPanelistLinks    Json?
  /// When true, users submit registration; admin approves before enrollment (webinars and office hours).
  registrationRequiresApproval Boolean @default(false)
  /// Public registration: anyone can register with name and email (no login, no
  /// approval) and is emailed a personal link to the registration survey.
  publicRegistrationEnabled Boolean @default(false)
  
  // Payment configuration
  honorariumAmount  Int?     // Amount in cents (e.g., 50000 = $500)
  /// Days after survey completion before an unpaid honorarium is overdue (1–30).
  honorariumWindowDays Int @default(30)
  /// Days after survey completion when an unpaid honorarium is at risk (1 through the window).
  honorariumAtRiskDays Int @default(21)
  
  // Zoom Events integration
  zoomSessionType   ProgramZoomSessionType @default(WEBINAR)
  zoomMeetingId     String?
  zoomMeetingPassword String?
  zoomJoinUrl       String?
  zoomStartUrl      String?  // For host/KOL
  /// Set from Zoom meeting.ended / webinar.ended webhooks when configured (preferred for post-event survey timing).
  zoomSessionEndedAt DateTime?
  /// True when this program was auto-created by a webinar.created / meeting.created Zoom webhook (outside the app).
  /// Indicates admin review is required to fill in sponsor, honorarium, Jotform forms, host bio, etc.
  importedViaWebhook Boolean @default(false)
  /// Official CHM Content ID (CLIENT-YY-SS_BBBnn) when assigned via Program Registry.
  chmProgramId       String?
  /// Hub campaigns.id stored as a string (e.g. "42"). Nullable until an admin links the Program.
  /// Export and Hub VTT ingest key off this; unlinked programs are omitted from packets.
  campaignId         String?

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  publishedAt       DateTime?
  
  // Relations
  videos            Video[]
  enrollments       ProgramEnrollment[]
  programRegistrations ProgramRegistration[]
  officeHoursSlots OfficeHoursSlot[]
  programFormLinks  ProgramFormLink[]
  surveys           Survey[]
  publicRegistrations PublicRegistration[]
  payments          Payment[]
  cmeCredits        CMECredit[]
  webinarParticipantEvents WebinarParticipantEvent[]
  zoomRecordingSessions ZoomRecordingSession[]
  zoomRecordingFiles    ZoomRecordingFile[]
  emailOverrides        ProgramEmailOverride[]

  @@index([status])
  @@index([startDate])
  @@index([status, startDate])
  @@index([chmProgramId])
  @@index([campaignId])
  @@map("Program")
}

/// Customizable participant email kinds (per-event overrides).
enum ProgramEmailKind {
  REGISTRATION_RECEIVED
  REGISTRATION_APPROVED
  SESSION_REMINDER
  POST_WEBINAR_SURVEY
  MISSED_SESSION
  PAYMENT_FOLLOW_UP
}

/// Per-event override of editable email copy. Locked chrome (footer, required
/// links) always comes from the platform template renderer.
model ProgramEmailOverride {
  id              String          @id @default(cuid())
  programId       String
  emailKind       ProgramEmailKind
  subject         String
  greeting        String          @db.Text
  body            String          @db.Text
  signOff         String          @db.Text
  updatedByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  program  Program                     @relation(fields: [programId], references: [id], onDelete: Cascade)
  versions ProgramEmailOverrideVersion[]

  @@unique([programId, emailKind])
  @@index([programId])
  @@map("ProgramEmailOverride")
}

/// Immutable snapshot of each override save (user + time).
model ProgramEmailOverrideVersion {
  id              String          @id @default(cuid())
  overrideId      String
  programId       String
  emailKind       ProgramEmailKind
  subject         String
  greeting        String          @db.Text
  body            String          @db.Text
  signOff         String          @db.Text
  editedByUserId String?
  editedAt        DateTime        @default(now())

  override ProgramEmailOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)

  @@index([overrideId, editedAt])
  @@index([programId, emailKind])
  @@map("ProgramEmailOverrideVersion")
}

/// Catalog row for a Zoom webinar/meeting with cloud recordings (linked or Zoom-only).
model ZoomRecordingSession {
  id              String   @id @default(cuid())
  zoomMeetingId   String   @unique
  zoomUuid        String?
  topic           String?
  hostEmail       String?
  sessionType     ProgramZoomSessionType @default(WEBINAR)
  startTime       DateTime?
  durationMinutes Int?
  totalSizeBytes  Int?
  programId       String?
  chmProgramId    String?
  firstSyncedAt   DateTime @default(now())
  lastSyncedAt    DateTime @updatedAt
  attendeeReportS3Bucket           String?
  attendeeReportS3Key              String?
  attendeeReportExportedAt         DateTime?
  attendeeReportParticipantCount   Int?
  attendanceLastImportedAt         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  files   ZoomRecordingFile[]
  attendanceParticipants ZoomAttendanceParticipant[]

  @@index([programId])
  @@index([startTime])
  @@index([sessionType])
  @@index([chmProgramId])
  @@map("ZoomRecordingSession")
}

/// Zoom cloud recording file (metadata + optional S3 object after Pull).
model ZoomRecordingFile {
  id                  String   @id @default(cuid())
  sessionId           String
  programId           String?
  zoomMeetingId       String
  zoomRecordingFileId String
  fileType            String
  recordingType       String?
  fileExtension       String?
  fileSizeBytes       Int?
  s3Bucket            String?
  s3Key               String?
  chmAssetFilename    String?
  pullStatus          ZoomRecordingPullStatus @default(PENDING)
  pullError           String?
  recordingStart      DateTime?
  recordingEnd        DateTime?
  topic               String?
  pulledAt            DateTime?
  pulledByUserId      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  session ZoomRecordingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@unique([zoomMeetingId, zoomRecordingFileId])
  @@index([sessionId])
  @@index([programId])
  @@index([pullStatus])
  @@map("ZoomRecordingFile")
}

/// Manual account-wide Sync from Zoom (month-by-month crawl).
model ZoomSyncJob {
  id                String   @id @default(cuid())
  status            ZoomSyncJobStatus @default(QUEUED)
  monthsBack        Int
  sessionTypeFilter ProgramZoomSessionType?
  fromDate          DateTime
  toDate            DateTime
  startedAt         DateTime?
  finishedAt        DateTime?
  startedByUserId   String?
  progressJson      Json?
  errorMessage      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("ZoomSyncJob")
}

/// Manual import of Zoom Report API participant lists (12-month backfill).
model ZoomAttendanceImportJob {
  id                String   @id @default(cuid())
  status            ZoomSyncJobStatus @default(QUEUED)
  monthsBack        Int
  sessionTypeFilter ProgramZoomSessionType?
  fromDate          DateTime
  toDate            DateTime
  runAutoVerify     Boolean  @default(false)
  startedAt         DateTime?
  finishedAt        DateTime?
  startedByUserId   String?
  progressJson      Json?
  errorMessage      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("ZoomAttendanceImportJob")
}

/// Staged attendees for catalog sessions not yet linked to a Program.
model ZoomAttendanceParticipant {
  id                String   @id @default(cuid())
  sessionId         String
  zoomMeetingId     String
  zoomParticipantId String?
  participantName   String?
  participantEmail  String?
  joinTime          DateTime
  leaveTime         DateTime?
  durationSeconds   Int?
  isHost            Boolean  @default(false)
  importJobId       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  session ZoomRecordingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Partial uniques in migration 20260901140000 (with-id vs email+joinTime without id).
  @@index([sessionId])
  @@index([zoomMeetingId])
  @@map("ZoomAttendanceParticipant")
}

enum ZoomRecordingPullStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ZoomSyncJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum WebinarParticipantEventSource {
  WEBHOOK
  MEETING_SDK
  REPORT_IMPORT
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Zoom: WEBINAR = formal CME-style webinar; MEETING = interactive office hours (drop-in Q&A).
enum ProgramZoomSessionType {
  WEBINAR
  MEETING
}

enum ProgramRegistrationStatus {
  /// Intake survey completed; learner has not finished "Submit registration" yet.
  SURVEY_SUBMITTED
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
}

/// After registration is approved, LIVE sessions may require a second admin step before post-event survey / honorarium.
enum PostEventAttendanceStatus {
  NOT_REQUIRED
  PENDING_VERIFICATION
  VERIFIED
  DENIED
}

/// How the learner confirmed Stripe payout details for this program's honorarium.
enum PayoutDetailsEntryKind {
  /// Existing Connect details confirmed for this webinar/session.
  REUSED
  /// Details were entered or updated during this post-event flow.
  NEWLY_ENTERED
}

enum ProgramFormLinkKind {
  INTAKE
  PRE_EVENT
  POST_EVENT
  CUSTOM
}

/// Application / sign-up for a program (uncapped); admin approves → enrollment created
model ProgramRegistration {
  id                        String                    @id @default(cuid())
  userId                    String
  programId                 String
  status                    ProgramRegistrationStatus   @default(PENDING)
  intakeSubmissionId String?
  intakeJotformSubmittedAt  DateTime?
  officeHoursSlotId         String?
  adminNotes                String?                   @db.Text
  reviewedAt                DateTime?
  reviewedByUserId          String?
  calendarInviteSentAt      DateTime?
  postEventAttendanceStatus              PostEventAttendanceStatus @default(NOT_REQUIRED)
  postEventAttendanceReviewedAt        DateTime?
  postEventAttendanceReviewedByUserId  String?
  postEventSurveyAcknowledgedAt        DateTime?
  honorariumRequestedAt                DateTime?
  /// When the learner confirmed Stripe payout details for this program (per-webinar).
  payoutDetailsConfirmedAt             DateTime?
  /// Whether they reused existing Connect details or entered/updated them in this flow.
  payoutDetailsEntryKind               PayoutDetailsEntryKind?
  /// Set after the ~24h pre-session reminder email is sent. Reset to null when session time changes so a new reminder fires.
  reminder24hSentAt                    DateTime?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  slot    OfficeHoursSlot? @relation(fields: [officeHoursSlotId], references: [id], onDelete: SetNull)

  @@unique([userId, programId])
  @@index([programId])
  @@index([status])
  @@index([postEventAttendanceStatus])
  @@map("ProgramRegistration")
}

/// Jotform "Save & Continue" session id for resuming a partially filled form (24h TTL in app logic).
enum FormJotformScope {
  SURVEY
  INTAKE
}

model FormJotformProgress {
  id        String            @id @default(cuid())
  userId    String
  scope     FormJotformScope
  refId     String
  sessionId String
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, refId])
  @@index([expiresAt])
  @@map("FormJotformProgress")
}

/// Optional time blocks for office hours (aligned with meeting duration); users pick one at registration
model OfficeHoursSlot {
  id           String   @id @default(cuid())
  programId    String
  startsAt     DateTime
  endsAt       DateTime
  label        String?
  maxAttendees Int      @default(8)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  program       Program               @relation(fields: [programId], references: [id], onDelete: Cascade)
  registrations ProgramRegistration[]

  @@index([programId])
  @@map("OfficeHoursSlot")
}

/// Extra self-serve Jotform links per program (beyond Program scalar URLs)
model ProgramFormLink {
  id         String              @id @default(cuid())
  programId  String
  kind       ProgramFormLinkKind
  label      String
  jotformUrl String
  sortOrder  Int                 @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("ProgramFormLink")
}

// ============================================================================
// VIDEO MODEL
// ============================================================================
model Video {
  id          String   @id @default(cuid())
  programId   String
  
  // Video details
  title       String
  description String?  @db.Text
  
  // Video platform (Vimeo/YouTube)
  platform    VideoPlatform
  videoId     String   // Platform-specific video ID
  embedUrl    String   // Embed URL
  
  // Metadata
  duration    Int      // Duration in seconds
  order       Int      @default(0)  // Display order in program
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  views       VideoView[]

  @@index([programId])
  @@map("Video")
}

enum VideoPlatform {
  VIMEO
  YOUTUBE
}

// ============================================================================
// VIDEO VIEW MODEL (Progress Tracking)
// ============================================================================
model VideoView {
  id             String   @id @default(cuid())
  userId         String
  videoId        String
  
  // Progress tracking
  watchedSeconds Int      @default(0)
  progress       Float    @default(0)  // Percentage (0-100)
  completed      Boolean  @default(false)
  
  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  completedAt    DateTime?
  
  // Relations
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
  @@map("VideoView")
}

// ============================================================================
// PROGRAM ENROLLMENT MODEL
// ============================================================================
model ProgramEnrollment {
  id              String   @id @default(cuid())
  userId          String
  programId       String
  
  // Progress tracking
  overallProgress Float    @default(0)  // Percentage (0-100)
  completed       Boolean  @default(false)
  
  // Timestamps
  enrolledAt      DateTime @default(now())
  completedAt     DateTime?
  updatedAt       DateTime @updatedAt
  
  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program         Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([userId])
  @@index([programId])
  @@index([completed])
  @@index([userId, completed])
  @@map("ProgramEnrollment")
}

// ============================================================================
// SURVEY MODEL
// ============================================================================
model Survey {
  id          String   @id @default(cuid())
  programId   String
  
  // Survey details
  title       String
  description String?  @db.Text
  questions   Json     // Survey questions in JSON format
  type        SurveyType
  required    Boolean  @default(true)
  /// Set on any admin edit so template ensure/regeneration never overwrites this row.
  isCustomized Boolean @default(false)
  /// Monotonic schema revision for native questions; stamped onto SurveyResponse at submit.
  schemaVersion Int @default(1)
  
  // Jotform integration
  jotformFormId     String?
  jotformWebhookUrl String?
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  responses   SurveyResponse[]

  @@index([programId])
  @@map("Survey")
}

enum SurveyType {
  PRE_TEST
  POST_TEST
  FEEDBACK
  /// Webinar registration intake (native replacement for Jotform intake).
  INTAKE
}

// ============================================================================
// SURVEY RESPONSE MODEL
// ============================================================================
model SurveyResponse {
  id          String   @id @default(cuid())
  /// Null for a public registrant (no account): see publicRegistration.
  userId      String?
  surveyId    String
  /// Set for a response submitted through a public registration link.
  publicRegistrationId String? @unique
  
  // Response data
  answers     Json     // Survey answers in JSON format
  score       Float?   // Score if applicable
  /// Survey.schemaVersion at the time this response was submitted (answer-key snapshot).
  schemaVersion Int @default(1)
  /// True until the learner's final submit (post-event: with honorarium request).
  isDraft     Boolean  @default(false)

  /// Admin tags on free-text comments (HCP Beta: access | registration | livestream | honorarium).
  commentStageTags String[] @default([])
  
  // External submission id (UUID for native submit; Jotform id for legacy webhooks)
  submissionId String? @unique
  
  // Timestamps
  submittedAt DateTime @default(now())
  
  // Relations
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  publicRegistration PublicRegistration? @relation(fields: [publicRegistrationId], references: [id], onDelete: Cascade)

  @@unique([userId, surveyId])
  @@index([userId])
  @@index([surveyId])
  @@index([surveyId, schemaVersion])
  @@map("SurveyResponse")
}

// ============================================================================
// PAYMENT MODEL
// ============================================================================
model Payment {
  id          String   @id @default(cuid())
  userId      String
  programId   String?
  
  // Payment details
  amount      Int      // Amount in cents
  type        PaymentType
  status      PaymentStatus
  description String?
  
  // Stripe Connect transfers / payouts
  stripeTransferId String? @unique
  stripePayoutId   String?

  /// Unique per logical payout; worker uses ON CONFLICT DO NOTHING for SQS at-least-once / duplicate enqueue.
  idempotencyKey String? @unique

  /// How this payout is / was delivered (copied from user preference at pay time).
  deliveryMethod PaymentDeliveryMethod?
  /// Check lifecycle when deliveryMethod = CHECK (PENDING_MAIL, IN_TRANSIT, SENT, DELIVERED, RETURNED).
  checkStatus        String?
  checkMailedAt      DateTime?
  checkDeliveredAt   DateTime?
  checkTrackingInfo  String?

  // W9 tracking
  w9Collected Boolean  @default(false)
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  paidAt      DateTime?
  failedAt    DateTime?
  failureReason String?

  /// Set while an admin holds a PENDING payout. Cleared on release-hold.
  heldAt       DateTime?
  heldByUserId String?
  holdReason   String?
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program     Program? @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([programId])
  @@index([status])
  @@index([type])
  @@index([userId, createdAt])
  @@index([userId, status, paidAt])
  @@map("Payment")
}

enum PaymentType {
  HONORARIUM       // Payment for program participation
  CME_COMPLETION   // Bonus for completing CME
  SURVEY_BONUS     // Bonus for survey completion
  REFERRAL         // Referral bonus
}

enum PaymentStatus {
  PENDING      // Payment created but not processed
  PROCESSING   // Being processed by Stripe Connect
  PAID         // Successfully paid
  FAILED       // Payment failed
  CANCELLED    // Cancelled by admin
}

enum PreferredPaymentMethod {
  ACH
  CHECK
}

enum PaymentDeliveryMethod {
  ACH
  CHECK
}

// ============================================================================
// CME CREDIT MODEL
// ============================================================================
model CMECredit {
  id             String   @id @default(cuid())
  userId         String
  programId      String
  
  // Credit details
  credits        Float    // Number of CME credits earned
  certificateUrl String?  // S3 URL to PDF certificate
  
  // Timestamps
  issuedAt       DateTime @default(now())
  expiresAt      DateTime?
  
  // Relations
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program        Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([programId])
  @@map("CMECredit")
}

// ============================================================================
// WEBINAR PARTICIPANT EVENT (Zoom webhook join/leave tracking)
// ============================================================================
model WebinarParticipantEvent {
  id               String   @id @default(cuid())
  programId        String
  program          Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId           String?  // Matched CHT user (by email) if found
  event            String   // "JOINED" | "LEFT"
  zoomMeetingId    String?  // Zoom meeting ID from webhook
  zoomParticipantId String? // Zoom participant ID in meeting
  participantName  String?
  participantEmail String?
  isHost           Boolean  @default(false)
  occurredAt       DateTime @default(now())
  rawPayload       Json?    // Full webhook payload for debugging
  source           WebinarParticipantEventSource @default(WEBHOOK)
  joinTime         DateTime?
  leaveTime        DateTime?
  durationSeconds  Int?
  importJobId      String?

  @@unique([programId, zoomParticipantId, event, source, joinTime])
  @@index([programId])
  @@index([userId])
  @@index([occurredAt])
  @@index([event])
  @@index([zoomMeetingId])
  @@index([source])
  @@map("WebinarParticipantEvent")
}

// ============================================================================
// ANALYTICS EVENT MODEL
// ============================================================================
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String
  
  // Event details
  eventName String
  eventData Json     // Event payload
  
  // Metadata
  ipAddress String?
  userAgent String?
  
  // Timestamp
  timestamp DateTime @default(now())
  
  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventName])
  @@index([timestamp])
  @@map("AnalyticsEvent")
}

// ============================================================================
// OUTBOUND EMAIL LOG (admin invitations / delivery trail)
// ============================================================================
enum OutboundEmailType {
  REGISTRATION_INVITE
  REGISTRATION_SUBMITTED
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  REGISTRATION_REVOKED
  PRE_SESSION_REMINDER
  POST_EVENT_SURVEY
  MISSED_SESSION
  OPERATIONAL
  PUBLIC_REGISTRATION
  WEBINAR_ACCESS
  REPORT_READY
  /// Honorarium / payment follow-up after survey completion.
  PAYMENT_FOLLOW_UP
  OTHER
}

enum OutboundEmailStatus {
  SENT
  DELIVERED
  BOUNCED
  FAILED
  UNSUBSCRIBED
}

/// One row per platform-sent email (per program when multi-program invite).
model OutboundEmailLog {
  id               String              @id @default(cuid())
  toEmail          String
  toName           String?
  emailType        OutboundEmailType
  status           OutboundEmailStatus @default(SENT)
  programId        String?
  userId           String?
  registrationId   String?
  inviteId         String?
  /// Null = automatic/system (worker, webhook); otherwise admin who triggered send.
  sentByUserId     String?
  sesMessageId     String?
  subject          String?
  errorMessage     String?
  /// When SES (or webhook) last updated delivery status.
  providerStatusAt DateTime?
  /// If this send is a resend, points at the prior log row.
  resentFromId     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([programId, createdAt])
  @@index([toEmail])
  @@index([status])
  @@index([emailType])
  @@index([sesMessageId])
  @@map("OutboundEmailLog")
}

// ============================================================================
// ADMIN AUDIT LOG (SOC 2: admin mutation trail)
// ============================================================================
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String?
  /// ADMIN | HCP | anonymous | system (when known)
  actorRole  String?
  action     String
  resource   String?
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@index([resource, resourceId])
  @@index([actorRole])
  @@map("AdminAuditLog")
}

// ============================================================================
// KOL DIRECTORY VISIBILITY (CHT overlay: Content Hub remains source of roster)
// ============================================================================
model KolDirectoryVisibility {
  slug            String   @id
  visibleOnPublic Boolean  @default(true)
  visibleOnApp    Boolean  @default(true)
  updatedAt       DateTime @updatedAt
  updatedByUserId String?

  @@map("kol_directory_visibility")
}

// ============================================================================
// REGISTRATION INVITES (SCRUM-175: opaque tokens for unregistered invite links)
// ============================================================================
// One row per unregistered-email invite generated by the admin invite modal.
// Token lives in the invite URL; resolved server-side at /api/invites/:token to
// pre-fill the signup form with the invited email + target programs. Prevents
// email PII from appearing in URLs / referrer headers / server logs.
model RegistrationInvite {
  id               String    @id @default(cuid())
  token            String    @unique
  email            String
  programIds       String[]
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  usedAt           DateTime?
  createdByAdminId String?

  @@index([token])
  @@index([email])
  @@index([expiresAt])
  @@map("registration_invites")
}

model CompanionConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CompanionMessage[]

  @@index([userId, updatedAt])
  @@map("CompanionConversation")
}

model CompanionMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        String
  /// Citation events emitted with an assistant answer (one per source).
  citations      Json?
  finishReason   String?
  createdAt      DateTime @default(now())

  conversation CompanionConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("CompanionMessage")
}

// ============================================================================
// PUBLIC REGISTRATION (no account)
// ============================================================================

/// Someone who registered for a program through its public page (name and
/// email, no login). They are emailed a personal link (token) to the
/// program's registration survey. Kept out of HubSpot and the HCP roster.
model PublicRegistration {
  id            String    @id @default(cuid())
  programId     String
  email         String
  firstName     String
  lastName      String
  /// Secret for the emailed survey link.
  token         String    @unique
  emailSentAt   DateTime?
  /// When the registration survey was submitted through the link.
  submittedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  program        Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  surveyResponse SurveyResponse?

  @@unique([programId, email])
  @@index([programId])
  @@map("PublicRegistration")
}
