# Required for local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cht_platform"

# Optional - defaults work for docker-compose
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Colorized pino-pretty logs for local terminals. Leave unset/false in ECS (JSON for CloudWatch).
LOG_PRETTY=true

# Actuator /actuator/info metadata (set automatically in ECS task definition)
APP_NAME=cht-platform-backend
CHT_ENVIRONMENT=development
IMAGE_TAG=local
# CONTAINER_IMAGE=  # full ECR URI in ECS only

# Optional - leave empty for local testing (some features disabled)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=

# Amazon Cognito (when set, Cognito is used for login/signup/OAuth)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1
COGNITO_HOSTED_UI_BASE_URL=
COGNITO_JWKS_URI=

# Google reCAPTCHA v3 (optional: when set, login/join require valid tokens)
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Session idle TTL in seconds (default 1800 = 30 min). Slid on authenticated activity.
SESSION_TTL_SECONDS=1800
# Absolute session TTL from login (default 28800 = 8h). Not extended by activity.
SESSION_ABSOLUTE_TTL_SECONDS=28800

# Stripe Connect Express (sole payment rail)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...          # "Your account" destination
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...  # "Connected accounts" destination

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SQS_PAYMENT_QUEUE_URL=

# Session banner uploads (S3). When both are set, admin UI shows upload + POST /admin/uploads/session-hero/presign works.
# Bucket must allow CORS PUT from your admin origin; public reads for prefix session-heroes/* (see Terraform module s3-session-assets).
# Zoom cloud recordings reuse this same bucket under private prefix zoom-recordings/{programId}/… (presigned GET only).
# SESSION_ASSETS_S3_BUCKET=
# SESSION_ASSETS_PUBLIC_URL_BASE=https://your-bucket.s3.us-east-1.amazonaws.com
# Default months of Zoom account history for manual Sync (Reporting → Zoom Recordings catalog)
# ZOOM_RECORDINGS_SYNC_MONTHS_BACK=24
# Default months for Zoom Report API attendee import (LIVE → Zoom Recordings)
# ZOOM_ATTENDANCE_IMPORT_MONTHS_BACK=12
# ZOOM_ATTENDANCE_IMPORT_AUTO_VERIFY=false
# ZOOM_ATTENDANCE_REPORT_FILENAME=attendees.csv

# Amazon SES (registration approved for Live / Office Hours). In ECS, IAM on the task role is enough; keys optional.
EMAIL_FROM="Community Health Media" <info@communityhealth.media>
# Set to false in local dev if you do not have SES send permissions
EMAIL_ENABLED=true

# Survey bonus payment (cents, 0 = disabled). Sent to payment queue on survey submit.
SURVEY_BONUS_AMOUNT_CENTS=0

# Content Hub (KOL network + HCP upsert dual-write; auth = Cognito M2M Bearer)
# Dev:  CONTENTHUB_BASE_URL=https://devhub.communityhealth.media/api/public
# Prod: CONTENTHUB_BASE_URL=https://contenthub.communityhealth.media/api/public
# CONTENTHUB_ADMIN_BASE_URL=https://devhub.communityhealth.media/api/admin
# COGNITO_M2M_PLATFORM_CLIENT_ID= (from SM cht-{env}-cognito-m2m-platform)
# COGNITO_M2M_PLATFORM_CLIENT_SECRET=
# COGNITO_M2M_TOKEN_URL=https://chm-dev.auth.us-east-1.amazoncognito.com/oauth2/token
# COGNITO_M2M_HUB_SCOPES=hub/catalog.read hub/admin.read hub/admin.create hub/admin.update hub/admin.delete

# WordPress-as-CMS catalog (ContentHub /api/public/clips with inline wordpress field)
# On dev (CHT_ENVIRONMENT=dev), catalog auto-uses ContentHub when CONTENTHUB_BASE_URL is set.
# CATALOG_USE_CONTENTHUB=true
# CATALOG_WORDPRESS_ONLY=true
# CATALOG_CLIPS_CACHE_TTL_SECONDS=3600
# CATALOG_WORDPRESS_CACHE_TTL_SECONDS=300

# Redis (optional: 1h default TTL; clips use CATALOG_CLIPS_*, WP posts use CATALOG_WORDPRESS_*)
# REDIS_URL=redis://localhost:6379
# REDIS_CACHE_TTL_SECONDS=3600
# Shared secret for POST /api/internal/cache/clear (see scripts/clear-upstream-cache.sh)
# INTERNAL_CACHE_SECRET=change-me-in-production

# CHT Companion (SSE RAG chat via Nest BFF POST /api/chat)
# COMPANION_BASE_URL=http://cht-companion:8080
# Companion authenticates with the platform M2M token (COGNITO_M2M_PLATFORM_*) for this scope.
# COGNITO_M2M_COMPANION_SCOPE=companion/chat.invoke

# Get an API key from Google Cloud Console, enable YouTube Data API v3.
# YOUTUBE_API_KEY=your_api_key
# YOUTUBE_PLAYLIST_IDS=PLxxx,PLyyy   # Or use data/youtube-playlist-ids.txt (local dev default)
# YOUTUBE_PLAYLIST_CSV=data/youtube-playlists.csv

# Zoom (Server-to-Server OAuth for webinars). Create app at marketplace.zoom.us
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_WEBHOOK_SECRET=   # Secret token for webhook signature verification (from Event Subscriptions)
# Meeting SDK (embed Office Hours in browser) - create a "Meeting SDK" app in Zoom Marketplace; not the S2S OAuth app
# ZOOM_SDK_KEY=
# ZOOM_SDK_SECRET=

# Jotform API (CPR-5): create/clone/attach on schedule is removed. Native surveys are created instead.
# Keep JOTFORM_API_KEY (+ optional JOTFORM_BASE_URL) for historical submission export (#611) and any remaining webhook ingest.
# See https://api.jotform.com/docs/
# JOTFORM_API_KEY=
# JOTFORM_BASE_URL=https://api.jotform.com
# Optional: fallback intake URL when resolving *existing* program.jotformIntakeFormUrl (read path only; not used to attach new forms)
# JOTFORM_WEBINAR_DEFAULT_INTAKE_URL=
# Deprecated create-only vars (ignored): JOTFORM_WEBINAR_INVITATION_TEMPLATE_FORM_ID,
# JOTFORM_WEBINAR_POST_EVENT_SHARED_FORM_ID, JOTFORM_WEBINAR_POST_EVENT_TEMPLATE_FORM_ID, JOTFORM_TEMPLATE_FORM_ID,
# SURVEYS_USE_LEGACY_JOTFORM_FORMS
# Form webhook (historical): POST /api/webhooks/jotform
# Set to true only if you need raw Zoom webinars in LIVE that are not yet in the DB (skips Jotform/approval flow).
# WEBINARS_LIST_ZOOM_FALLBACK=false
