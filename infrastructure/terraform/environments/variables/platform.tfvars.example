# CHT Platform - Single Account (us-east-1)
# Domain: testapp.communityhealth.media (single domain, endpoints follow)
# Capacity: 600 users (non-simultaneous) - db.t3.small sufficient
#
# Local: copy to platform.tfvars and fill in secrets (platform.tfvars is gitignored).
# CI (deploy-prod.yml): uses this file for non-secret defaults; GitHub Environment
# secrets are injected as TF_VAR_* and override empty secret values below.
# Docker images are overridden at apply time via -var=backend_image/worker_image.

project     = "cht-platform"
environment = "platform"

# Docker Images (update after building/pushing; CI overrides on deploy)
backend_image = "233636046512.dkr.ecr.us-east-1.amazonaws.com/cht-platform-backend:platform-latest"
worker_image  = "233636046512.dkr.ecr.us-east-1.amazonaws.com/cht-platform-worker:platform-latest"

# Database (600 users, non-simultaneous)
rds_instance_class    = "db.t3.small"
rds_engine_version    = "15.17"
rds_allocated_storage = 20
rds_multi_az          = false
rds_backup_retention  = 7

# Compute (autoscaling disabled - min=max=desired)
backend_task_cpu      = 512
backend_task_memory   = 1024
backend_desired_count = 2
backend_min_capacity  = 2
backend_max_capacity  = 2

worker_task_cpu      = 512
worker_task_memory   = 1024
worker_desired_count = 2
worker_min_capacity  = 2
worker_max_capacity  = 2

# SSL Certificates (testapp - issued; CI overrides via TF_VAR_acm_certificate_arn / TF_VAR_cloudfront_certificate_arn)
acm_certificate_arn        = "arn:aws:acm:us-east-1:233636046512:certificate/3d4f17ef-46f3-45a2-84a0-c61fb94769bb"
cloudfront_certificate_arn = "arn:aws:acm:us-east-1:233636046512:certificate/3d4f17ef-46f3-45a2-84a0-c61fb94769bb"

# Domain (testapp.communityhealth.media)
domain_name = "testapp.communityhealth.media"

# Application URLs (non-secret)
supabase_url      = "https://mediahub.communityhealth.media"
mediahub_base_url = "https://mediahub.communityhealth.media/api/public"

# Application secrets — set in platform.tfvars locally or TF_VAR_* in CI (never commit real values)
supabase_anon_key    = ""
gotrue_jwt_secret    = ""
mediahub_api_key     = ""
youtube_api_key      = ""
youtube_playlist_ids = ""

# Bill.com (payment processing - HCP payouts via ACH/check)
# bill_dev_key             = ""
# bill_username            = ""
# bill_password            = ""
# bill_org_id              = ""
# bill_funding_account_id  = ""
# bill_mfa_remember_me_id  = ""
# bill_mfa_device_name     = "AndrewsPhone"
# bill_webhook_secret      = ""

# Zoom (Server-to-Server OAuth for webinars). Scopes: webinar:read:admin, webinar:read
# zoom_account_id     = ""
# zoom_client_id      = ""
# zoom_client_secret  = ""
# zoom_webhook_secret = ""
# zoom_sdk_key        = ""
# zoom_sdk_secret     = ""

# jotform_api_key = ""

# Shared post-event survey (single form for all webinars)
jotform_webinar_post_event_shared_form_id = "260698533879881"

# Default webinar registration Jotform when a Program has no intake URL in Admin
jotform_webinar_default_intake_url = "https://communityhealthmedia.jotform.com/261116295463861"

# admin_bootstrap_secret = ""
# hubspot_access_token   = ""

# Worker / session reminders
worker_ses_from_email                 = "info@communityhealth.media"
session_reminders_schedule_expression = "cron(0 0/6 * * ? *)"

# Optional: SNS for alerts
# alarm_notification_emails = ["ops@example.com"]
