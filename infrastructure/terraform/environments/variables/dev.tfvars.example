# CHT Platform - Dev (us-east-1 primary, us-east-2 DR standby)
# Domain: devapp.communityhealth.media
#
# Local: copy to dev.tfvars and fill in secrets (dev.tfvars is gitignored).
# CI: use GitHub Environment "development" secrets as TF_VAR_* on deploy.
# Do NOT add secret variables here — -var-file beats TF_VAR_* in Terraform.

project     = "cht-platform"
environment = "dev"

backend_image = "233636046512.dkr.ecr.us-east-1.amazonaws.com/cht-platform-backend:platform-latest"
worker_image  = "233636046512.dkr.ecr.us-east-1.amazonaws.com/cht-platform-worker:platform-latest"

rds_instance_class    = "db.t3.micro"
rds_engine_version    = "15.17"
rds_allocated_storage = 20
rds_multi_az          = false
rds_backup_retention  = 1

backend_task_cpu      = 256
backend_task_memory   = 512
backend_desired_count = 1
backend_min_capacity  = 1
backend_max_capacity  = 2

worker_task_cpu      = 256
worker_task_memory   = 512
worker_desired_count = 1
worker_min_capacity  = 1
worker_max_capacity  = 2

# SSL — set in dev.tfvars locally after ./scripts/request-certificate.sh devapp

domain_name = "devapp.communityhealth.media"

secrets_replica_regions = ["us-east-2"]
enable_ecr_replication  = true

# secondary_api_origin_domain = ""  # from us-east-2 terraform output after DR deploy
dr_rds_instance_class = "db.t3.micro"

# Non-secret URLs
supabase_url      = "https://mediahub.communityhealth.media"
mediahub_base_url = "https://mediahub.communityhealth.media/api/public"

jotform_webinar_post_event_shared_form_id = "260698533879881"
jotform_webinar_default_intake_url        = "https://communityhealthmedia.jotform.com/261116295463861"

worker_ses_from_email                 = "info@communityhealth.media"
session_reminders_schedule_expression = "cron(0 0/12 * * ? *)"

enable_cognito_pools      = true
cognito_domain_prefix     = "chm-platform-dev"
cognito_user_pool_tier    = "ESSENTIALS"
cognito_mfa_configuration = "OPTIONAL"

# Secrets (supabase_anon_key, gotrue_jwt_secret, mediahub_api_key, youtube_*, bill_*,
# zoom_*, jotform_api_key, admin_bootstrap_secret, hubspot_access_token, acm ARNs, etc.)
# → dev.tfvars locally, or GitHub Environment "development" secrets as TF_VAR_* in CI.
